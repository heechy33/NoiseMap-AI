# Directory containing the SQLite feature databases
# Expected files: new_airports.db, night_life.db, bus_station.db, train_station.db
NOISE_DB_DIR=/path/to/databases

# Path to worldcities.csv (defaults to backend/app/worldcities.csv if not set)
# CITIES_CSV_PATH=/path/to/worldcities.csv

# Path to the trained XGBoost model file (.pkl)
MODEL_PATH=app/shuffled_noise_model.pkl

# Google Maps API key (used by the frontend for Places autocomplete)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Gemini API key for AI-generated location insights
GEMINI_API_KEY=your_gemini_api_key
